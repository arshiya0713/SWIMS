<?xml version="1.0" encoding="utf-8"?>
<!-- Same aurora treatment, scaled for the home-screen widget. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#14103C"
                android:centerColor="#2B1264"
                android:endColor="#3B1D6E"
                android:angle="135" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#A68B5CF6"
                android:endColor="#008B5CF6"
                android:gradientRadius="150dp"
                android:centerX="0.1"
                android:centerY="0.15" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#8022D3EE"
                android:endColor="#0022D3EE"
                android:gradientRadius="160dp"
                android:centerX="0.95"
                android:centerY="0.9" />
            <corners android:radius="24dp" />
        </shape>
    </item>

</layer-list>
